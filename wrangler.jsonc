{
  // Serves the MkDocs-generated site as static assets on Cloudflare Workers.
  //
  // The build step (see Cloudflare project settings) runs:
  //     pip install -r requirements.txt && mkdocs build
  // which produces ./site — the directory published below.
  //
  // This is an assets-only Worker: there is no `main` script, because the
  // site is entirely static. Cloudflare serves the files directly from its
  // edge network.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lp-projects-docs",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./site",
    // MkDocs emits a styled 404.html at the site root; serve it for unknown
    // paths instead of Cloudflare's default error page.
    "not_found_handling": "404-page"
  }
}
